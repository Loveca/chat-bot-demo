# DeepSeek API (server-side only; never expose in client code)
DEEPSEEK_API_KEY=

# Optional overrides
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Optional system prompt prepended to every conversation
SYSTEM_PROMPT=

# Max user/assistant messages sent to the model (default: 40)
MAX_HISTORY_MESSAGES=40
